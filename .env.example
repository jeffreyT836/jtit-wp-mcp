# Copy to .env and fill in real values. Never commit the real .env file.

# One Application Password per site, matching each site's `passwordEnv` in
# config/sites.json. Generate these in WP Admin > Users > (user) > Application Passwords.
WP_KLANT_A_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
WP_KLANT_B_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Alternative: point at a Docker/Compose secret file instead of an inline value.
# WP_KLANT_A_APP_PASSWORD_FILE=/run/secrets/wp_klant_a_app_password

# --- Global server config (see docs/SPEC.md §1) ---
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=3000
MCP_HTTP_HOST=0.0.0.0
# Required (min 32 chars) when MCP_TRANSPORT=http. Generate with: openssl rand -hex 32
MCP_HTTP_TOKEN=replace-with-a-random-32-plus-character-token
# A bare entry (no ":port") is also accepted as "<entry>:<MCP_HTTP_PORT>", since that is the
# Host header a normal request actually sends. If you map this container to a *different*
# host-side port (e.g. `docker run -p 127.0.0.1:3399:3000`), add the matching "host:3399"
# entry explicitly — MCP_HTTP_PORT is the container's own port (3000) and cannot know the
# host-side port Docker mapped it to. See README §3.3/§4.2.
MCP_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1
MCP_READ_ONLY=false
WP_TIMEOUT_MS=30000
WP_UPDATE_TIMEOUT_MS=300000
FLEET_CONCURRENCY=4
# AUDIT_LOG_FILE=/app/logs/audit.jsonl
