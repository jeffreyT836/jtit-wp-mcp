# Copy to .env and fill in real values. Never commit the real .env file.

# Sites + their Application Passwords live in the encrypted SQLite store (data/sites.db),
# managed with `node dist/cli.js sites add|list|remove|import` — not in this file.
# Required: base64 of 32 random bytes. Generate with: openssl rand -base64 32
# Back it up (password manager): losing it makes every stored password unreadable.
SITES_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
# SITES_DB=./data/sites.db

# --- Global server config (see docs/SPEC.md §1) ---
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=3000
MCP_HTTP_HOST=0.0.0.0
# Required (min 32 chars) when MCP_TRANSPORT=http. Generate with: openssl rand -hex 32
MCP_HTTP_TOKEN=replace-with-a-random-32-plus-character-token
# A bare entry (no ":port") is also accepted as "<entry>:<MCP_HTTP_PORT>", since that is the
# Host header a normal request actually sends. If you map this container to a *different*
# host-side port (e.g. `docker run -p 127.0.0.1:3399:3000`), add the matching "host:3399"
# entry explicitly — MCP_HTTP_PORT is the container's own port (3000) and cannot know the
# host-side port Docker mapped it to. See README §3.3/§4.2.
MCP_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1
MCP_READ_ONLY=false
WP_TIMEOUT_MS=30000
WP_UPDATE_TIMEOUT_MS=300000
FLEET_CONCURRENCY=4
# The container runs with a read-only root filesystem (see docker-compose.yml), so
# /app/logs must be a writable volume for this to work — `docker compose` already mounts
# the `wp-fleet-logs` named volume there; for a plain `docker run`, add
# `-v wp-fleet-logs:/app/logs` (see README §3.1/§3.3).
# AUDIT_LOG_FILE=/app/logs/audit.jsonl

# --- Dashboard: meldingen (zie README §10.1) ---
# Slack incoming webhook of n8n-webhook; leeg = meldingen alleen in het dashboard.
# ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_TOKEN=
# DASHBOARD_PUBLIC_URL=https://wp-dashboard.jtit.nl
# ALERT_STALE_HOURS=3
