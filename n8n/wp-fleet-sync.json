{
  "name": "WP Fleet → Dashboard sync",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 1 }] }
      },
      "id": "a1f0c7a2-0001-4a6e-9a01-000000000001",
      "name": "Elk uur",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "// Welke MCP-tools we per run ophalen. Elke tool wordt een apart item.\nreturn [\n  { json: { kind: 'fleet_health', arguments: {} } },\n  { json: { kind: 'fleet_updates_report', arguments: {} } },\n];"
      },
      "id": "a1f0c7a2-0002-4a6e-9a01-000000000002",
      "name": "Tools",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://wp-mcp:3000/mcp",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Accept", "value": "application/json, text/event-stream" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jsonrpc: '2.0', id: $json.kind, method: 'tools/call', params: { name: $json.kind, arguments: $json.arguments } }) }}",
        "options": { "timeout": 300000 }
      },
      "id": "a1f0c7a2-0003-4a6e-9a01-000000000003",
      "name": "MCP: tool aanroepen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "credentials": {
        "httpHeaderAuth": { "id": "", "name": "WP MCP token" }
      }
    },
    {
      "parameters": {
        "jsCode": "// Pakt het JSON-resultaat uit het MCP-antwoord en maakt er een ingest-body van.\nreturn $input.all().map((item) => {\n  const res = item.json;\n  if (res.error) throw new Error(`MCP-fout (${res.id}): ${res.error.message}`);\n  const text = res.result?.content?.[0]?.text ?? 'null';\n  if (res.result?.isError) throw new Error(`Tool ${res.id} faalde: ${text}`);\n  return { json: { kind: res.id, collectedAt: new Date().toISOString(), data: JSON.parse(text) } };\n});"
      },
      "id": "a1f0c7a2-0004-4a6e-9a01-000000000004",
      "name": "Resultaat uitpakken",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://wp-dashboard:3001/api/ingest",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "a1f0c7a2-0005-4a6e-9a01-000000000005",
      "name": "Dashboard: data opslaan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0],
      "credentials": {
        "httpHeaderAuth": { "id": "", "name": "WP Dashboard ingest token" }
      }
    }
  ],
  "connections": {
    "Elk uur": { "main": [[{ "node": "Tools", "type": "main", "index": 0 }]] },
    "Tools": { "main": [[{ "node": "MCP: tool aanroepen", "type": "main", "index": 0 }]] },
    "MCP: tool aanroepen": { "main": [[{ "node": "Resultaat uitpakken", "type": "main", "index": 0 }]] },
    "Resultaat uitpakken": { "main": [[{ "node": "Dashboard: data opslaan", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
